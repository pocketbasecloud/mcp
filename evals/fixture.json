{
  "about": "What the eval cases start from. A case's fixture names entries of collections (created with their records), hooks (deployed; the instance restarts) and traffic (requests sent to the instance so its request log holds them), applied in that order. A record value \"{eval_members.0}\" is the id of that collection's first fixture record. The runner deletes every collection the instance did not have when it started, and the hooks and backups a case made.",
  "collections": {
    "eval_posts": {
      "note": "title is named by both rules and an index; two slugs repeat (post-2, post-7).",
      "definition": {
        "id": "evalposts000001",
        "name": "eval_posts",
        "type": "base",
        "listRule": "status = 'published' && title != ''",
        "viewRule": "status = 'published' && title != ''",
        "createRule": null,
        "updateRule": null,
        "deleteRule": null,
        "fields": [
          {
            "name": "title",
            "type": "text",
            "required": true,
            "max": 200
          },
          {
            "name": "slug",
            "type": "text",
            "max": 200
          },
          {
            "name": "status",
            "type": "select",
            "values": [
              "draft",
              "published"
            ],
            "maxSelect": 1
          },
          {
            "name": "created",
            "type": "autodate",
            "onCreate": true,
            "onUpdate": false
          },
          {
            "name": "updated",
            "type": "autodate",
            "onCreate": true,
            "onUpdate": true
          }
        ],
        "indexes": [
          "CREATE INDEX `idx_eval_posts_title` ON `eval_posts` (`title`)"
        ]
      },
      "records": [
        {
          "title": "Post 1",
          "slug": "post-1",
          "status": "published"
        },
        {
