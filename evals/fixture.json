  "hooks": {
    "eval_comments_throws": {
      "note": "A typo (toLowercase) makes every comment create throw: the client gets 400 \"Something went wrong\u2026\", the log status 0 and the TypeError.",
      "filename": "eval_comments.pb.js",
      "content": "/// <reference path=\"../pb_data/types.d.ts\" />\n\n// Refuses comments that look like spam.\nonRecordCreateRequest((e) => {\n  const body = e.record.getString(\"body\").toLowercase();\n  if (body.includes(\"buy now\")) {\n    throw new BadRequestError(\"Looks like spam.\");\n  }\n  e.next();\n}, \"eval_comments\");\n"
    }
  },
